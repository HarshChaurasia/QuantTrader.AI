# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# --- Alpaca (US stocks + crypto) ---
# Paper trading keys (https://alpaca.markets -> Paper Trading -> View API Keys)
ALPACA_KEY_ID=your_paper_key_id_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- LLM provider keys (pick one — choose in config/paper.yaml under news.llm.provider) ---
# Google Gemini — free tier at https://aistudio.google.com/app/apikey  (recommended start)
GEMINI_API_KEY=
# Anthropic Claude — https://console.anthropic.com/  (paid; better quality)
ANTHROPIC_API_KEY=

# --- OANDA (forex, Phase C) ---
# Demo account at https://www.oanda.com/demo-account/
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- System ---
# Active config profile: paper | live
EA_PROFILE=paper
# Log level: DEBUG | INFO | WARNING | ERROR
EA_LOG_LEVEL=INFO
